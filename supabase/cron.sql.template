-- Harmonogram toru szybkiego. NIE jest migracja, bo zawiera sekrety: podmien wartosci w <...>
-- i wykonaj recznie w edytorze SQL Supabase. Skladnia pg_cron / pg_net do potwierdzenia w dokumentacji.
--
--   <PROJECT_REF>  identyfikator projektu Supabase
--   <CRON_SECRET>  ta sama wartosc co sekret CRON_SECRET ustawiony dla funkcji

create extension if not exists pg_cron;
create extension if not exists pg_net;

select cron.schedule('news-poll', '* * * * *', $$
    select net.http_post(
        url     := 'https://<PROJECT_REF>.supabase.co/functions/v1/news-poll',
        headers := jsonb_build_object('Content-Type', 'application/json', 'x-cron-secret', '<CRON_SECRET>'),
        body    := '{}'::jsonb
    );
$$);

select cron.schedule('macro-poll', '* * * * *', $$
    select net.http_post(
        url     := 'https://<PROJECT_REF>.supabase.co/functions/v1/macro-poll',
        headers := jsonb_build_object('Content-Type', 'application/json', 'x-cron-secret', '<CRON_SECRET>'),
        body    := '{}'::jsonb
    );
$$);

-- porzadki: newsy starsze niz 60 dni i historia wywolan crona
select cron.schedule('cleanup', '17 3 * * *', $$
    delete from news where fetched < now() - interval '60 days';
    delete from cron.job_run_details where end_time < now() - interval '7 days';
$$);
