# Skopiuj do .env i uzupelnij. Nie commituj .env. W chmurze te same nazwy trafiaja do sekretow
# GitHub Actions (tor wolny) i Supabase Functions (tor szybki), patrz CLAUDE_CODE/ZADANIA.md.

# Supabase (klucz service_role: tylko po stronie serwera, nigdy w web/config.js)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
CRON_SECRET=

# Powiadomienia
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fundamenty
FRED_API_KEY=

# Darmowe modele do klasyfikacji newsow: wystarczy jeden lub dwa klucze (kolejnosc w config/llm.yaml)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
