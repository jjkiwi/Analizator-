# Usluga systemd (VPS / Raspberry Pi / Linux).
# 1. Popraw User i sciezki ponizej (zalozenie: repo w /opt/analizator-cfd, venv w .venv).
# 2. sudo cp deploy/analizator-cfd.service /etc/systemd/system/
# 3. sudo systemctl daemon-reload && sudo systemctl enable --now analizator-cfd
# Logi: journalctl -u analizator-cfd -f   (rotacje robi journald; limit: SystemMaxUse= w /etc/systemd/journald.conf)
[Unit]
Description=Analizator CFD (praca ciagla, bez skladania zlecen)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=cfd
WorkingDirectory=/opt/analizator-cfd
ExecStart=/opt/analizator-cfd/.venv/bin/cfd -v run
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
# .env czyta sam program z WorkingDirectory
MemoryMax=1G
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
